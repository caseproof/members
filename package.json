{
  "name": "members",
  "version": "2.3.0",
  "description": "Members plugin for WordPress",
  "main": "index.js",
  "scripts": {
    "build": "gulp build && npm run build:block-permissions",
    "build:styles": "gulp styles",
    "build:scripts": "gulp scripts",
    "watch": "gulp",
    "build:block-permissions": "wp-scripts build editor=./src-js/block-permissions/editor.js upsell=./src-js/block-permissions/upsell.js --output-path=js/build/block-permissions",
    "watch:block-permissions": "wp-scripts start editor=./src-js/block-permissions/editor.js upsell=./src-js/block-permissions/upsell.js --output-path=js/build/block-permissions"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caseproof/members.git"
  },
  "author": "The MemberPress Team",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/caseproof/members/issues"
  },
  "homepage": "https://github.com/caseproof/members#readme",
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/runtime": "^8.0.8",
    "@wordpress/scripts": "^28.6.0",
    "gulp": "^5.0.0",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-line-ending-corrector": "^1.0.3",
    "gulp-rename": "^2.0.0",
    "gulp-terser": "^2.1.0",
    "gulp-uglifycss": "^1.1.0"
  }
}
